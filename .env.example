NODE_ENV=development

APP_NAME="Relaticle Next"
APP_URL=http://localhost:3000
# Required in Compose. Generate with: openssl rand -base64 32
APP_KEY=
APP_PREVIOUS_KEYS=
APP_TIMEZONE=UTC
APP_PANEL_DOMAIN=
APP_PANEL_PATH=app

# Existing session compatibility
SESSION_COOKIE=
SESSION_LIFETIME=120
REMEMBER_ME_DAYS=30
REQUIRE_EMAIL_VERIFICATION=true

# Browser login providers (callback: APP_URL/auth/oauth/{provider}/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile (both values are required when enabled)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostgreSQL
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=relaticle
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10

# Redis and BullMQ
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=
CACHE_PREFIX=
BULLMQ_PREFIX=bull

# Runtime controls
HEALTH_CHECK_TIMEOUT_MS=2000
# Worker defaults to 3001; scheduler defaults to 3002.
HEALTH_PORT=3001
SCHEDULER_OPERATION_TIMEOUT_MS=900000
ACTIVITYLOG_ENABLED=true
RELATICLE_FEATURE_BILLING=false

# AI chat providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_KEY=
OPENAI_COMPATIBLE_MODELS=

# Stripe billing
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_CREDIT_PACK_PRICE_ID=
STRIPE_CREDIT_PACK_CREDITS=1000
STRIPE_PRO_TRIAL_DAYS=14

# Worker email delivery: log or resend
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Relaticle Next"
RESEND_KEY=

# Mailcoach subscriber endpoint, for example https://mail.example/api/email-lists/{uuid}
MAILCOACH_ENABLED_SUBSCRIBERS_SYNC=false
MAILCOACH_API_ENDPOINT=
MAILCOACH_API_TOKEN=
