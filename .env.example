NODE_ENV=development

APP_NAME="Relaticle Next"
APP_URL=http://localhost:3000
APP_KEY=
APP_PREVIOUS_KEYS=
APP_TIMEZONE=UTC
APP_PANEL_DOMAIN=
APP_PANEL_PATH=app

# Existing session compatibility
SESSION_COOKIE=
SESSION_LIFETIME=120
REQUIRE_EMAIL_VERIFICATION=true

# PostgreSQL
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=relaticle
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10

# Redis and BullMQ
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=
CACHE_PREFIX=
BULLMQ_PREFIX=bull

# Runtime controls
HEALTH_CHECK_TIMEOUT_MS=2000
ACTIVITYLOG_ENABLED=true
RELATICLE_FEATURE_BILLING=false

# Worker email delivery: log or resend
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Relaticle Next"
RESEND_KEY=
