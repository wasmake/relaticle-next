{
    "name": "relaticle-next",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "next dev apps/web",
        "build": "npm run build:web && npm run build:worker",
        "build:web": "next build apps/web",
        "build:worker": "tsc -p apps/worker/tsconfig.json",
        "start": "next start apps/web",
        "start:worker": "node dist/worker/apps/worker/index.js",
        "lint": "eslint apps/web/src apps/worker apps/scheduler packages/queue/src tests/next",
        "typecheck": "npm run typecheck:web && npm run typecheck:worker && npm run typecheck:scheduler",
        "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
        "typecheck:worker": "tsc --noEmit -p apps/worker/tsconfig.json",
        "typecheck:scheduler": "tsc --noEmit -p apps/scheduler/tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "bullmq": "^6.1.2",
        "drizzle-orm": "^0.45.2",
        "ioredis": "^6.0.0",
        "next": "^16.3.1",
        "postgres": "^3.4.9",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "resend": "^6.20.0",
        "ulidx": "^2.4.1",
        "zod": "^4.4.3"
    }
}
