{
    "name": "relaticle-next",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "next dev apps/web",
        "build": "npm run build:web && npm run build:worker && npm run build:scheduler",
        "build:web": "next build apps/web",
        "build:worker": "tsc -p apps/worker/tsconfig.json",
        "build:scheduler": "tsc -p apps/scheduler/tsconfig.json",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node scripts/db-migrate.mjs",
        "db:seed:e2e": "node scripts/e2e-seed.mjs",
        "start": "next start apps/web",
        "start:worker": "node dist/worker/apps/worker/index.js",
        "start:scheduler": "node dist/scheduler/apps/scheduler/index.js",
        "lint": "eslint apps/web/src apps/worker apps/scheduler packages/queue/src scripts tests/next tests/e2e playwright.config.ts drizzle.config.ts",
        "typecheck": "npm run typecheck:web && npm run typecheck:worker && npm run typecheck:scheduler",
        "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
        "typecheck:worker": "tsc --noEmit -p apps/worker/tsconfig.json",
        "typecheck:scheduler": "tsc --noEmit -p apps/scheduler/tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "playwright:install": "playwright install chromium",
        "check": "npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.1",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "bullmq": "^6.1.2",
        "drizzle-orm": "^0.45.2",
        "ioredis": "^6.0.0",
        "next": "^16.3.1",
        "postgres": "^3.4.9",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "resend": "^6.20.0",
        "ulidx": "^2.4.1",
        "zod": "^4.4.3"
    },
    "overrides": {
        "@esbuild-kit/core-utils": {
            "esbuild": "^0.25.4"
        }
    }
}
