{
    "name": "relaticle",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "next dev apps/web",
        "build": "npm run build:web && npm run build:worker",
        "build:web": "next build apps/web",
        "build:worker": "tsc -p apps/worker/tsconfig.json",
        "start": "next start apps/web",
        "start:worker": "node dist/worker/apps/worker/index.js",
        "lint:next": "eslint apps/web/src apps/worker apps/scheduler packages/queue/src tests/next",
        "typecheck": "npm run typecheck:web && npm run typecheck:worker && npm run typecheck:scheduler",
        "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
        "typecheck:worker": "tsc --noEmit -p apps/worker/tsconfig.json",
        "typecheck:scheduler": "tsc --noEmit -p apps/scheduler/tsconfig.json",
        "test:next": "vitest run",
        "test:next:watch": "vitest",
        "check:next": "npm run lint:next && npm run typecheck && npm run test:next && npm run build",
        "legacy:dev": "vite",
        "legacy:prebuild": "rm -f public/hot",
        "legacy:build": "npm run legacy:prebuild && vite build"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "autoprefixer": "^10.5.4",
        "chokidar": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.1",
        "laravel-vite-plugin": "^3.1.3",
        "playwright": "^1.62.1",
        "postcss": "^8.5.26",
        "postcss-nesting": "^14.0.1",
        "prettier": "^3.9.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.2.1",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.15.12",
        "@tailwindcss/vite": "^4.3.3",
        "@tiptap/core": "^3.29.2",
        "@tiptap/extension-document": "^3.29.2",
        "@tiptap/extension-hard-break": "^3.29.2",
        "@tiptap/extension-mention": "^3.29.2",
        "@tiptap/extension-paragraph": "^3.29.2",
        "@tiptap/extension-placeholder": "^3.29.2",
        "@tiptap/extension-text": "^3.29.2",
        "@tiptap/pm": "^3.29.2",
        "@tiptap/suggestion": "^3.29.2",
        "alpinejs": "^3.15.12",
        "bcryptjs": "^3.0.3",
        "bullmq": "^6.1.2",
        "dompurify": "^3.4.13",
        "drizzle-orm": "^0.45.2",
        "ioredis": "^6.0.0",
        "laravel-echo": "^2.4.0",
        "marked": "^18.0.9",
        "motion": "^13.0.0",
        "next": "^16.3.1",
        "postgres": "^3.4.9",
        "pusher-js": "^8.6.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "resend": "^6.20.0",
        "shiki": "^4.4.2",
        "ulidx": "^2.4.1",
        "zod": "^4.4.3"
    }
}
